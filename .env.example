# =============================================================================
# Shared Infrastructure — Environment Variables Template
# Copy this file to .env and set secure values for local/production environments.
# NEVER commit .env containing production secrets to version control.
# =============================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_super_secret_password_32_chars
POSTGRES_DB=trading_db
POSTGRES_PORT=5434

# Redis Configuration
REDIS_PORT=6379

# Jenkins Configuration
JENKINS_IMAGE_TAG=latest
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000
# Docker socket group GID (0 for Windows Docker Desktop, or match host GID on Linux e.g. 998/999)
DOCKER_SOCKET_GID=0

